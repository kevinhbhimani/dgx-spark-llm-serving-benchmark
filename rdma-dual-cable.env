# Dual-cable RDMA campaign environment.
# Source before running any script, on BOTH nodes before scripts/start_ray.sh:
#   source rdma-dual-cable.env
#
# scripts/load_env.sh gives already-exported values precedence over .env,
# so sourcing this file once per shell session is enough.

export CX_IFACE="enp1s0f0np0,enP2p1s0f0np0,enp1s0f1np1,enP2p1s0f1np1"
export NCCL_IB_DISABLE=0

# Record which transport every NCCL channel actually used. Logged only while
# communicators are set up, so it does not touch the measurement window.
# run_models.sh refuses a dual launch whose server log shows a socket fallback.
export NCCL_DEBUG=INFO
export NCCL_DEBUG_SUBSYS=INIT,NET

# The per-model campaign keeps one model at a time in the cache (the largest
# is ~139 GB), so the internal NVMe is normally enough. Point HF_CACHE at a
# bigger drive only if fewer than ~200 GB are free.
# export HF_CACHE=/mnt/model-cache
